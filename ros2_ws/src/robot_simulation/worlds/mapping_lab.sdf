      <link name="body">
        <collision name="collision"><geometry><box><size>10.2 0.2 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>10.2 0.2 1.2</size></box></geometry>
          <material><ambient>0.5 0.55 0.6 1</ambient><diffuse>0.5 0.55 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="east_wall">
      <static>true</static><pose>5 0 0.6 0 0 0</pose>
      <link name="body">
        <collision name="collision"><geometry><box><size>0.2 8 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 8 1.2</size></box></geometry>
          <material><ambient>0.5 0.55 0.6 1</ambient><diffuse>0.5 0.55 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="west_wall">
      <static>true</static><pose>-5 0 0.6 0 0 0</pose>
      <link name="body">
        <collision name="collision"><geometry><box><size>0.2 8 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.2 8 1.2</size></box></geometry>
          <material><ambient>0.5 0.55 0.6 1</ambient><diffuse>0.5 0.55 0.6 1</diffuse></material>
        </visual>
