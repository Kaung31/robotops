    </model>
    <model name="east_shelf">
      <static>true</static><pose>2.6 1.6 0.6 0 0 0</pose>
      <link name="body">
        <collision name="collision"><geometry><box><size>1.4 0.7 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.4 0.7 1.2</size></box></geometry>
          <material><ambient>0.5 0.55 0.6 1</ambient><diffuse>0.5 0.55 0.6 1</diffuse></material>
