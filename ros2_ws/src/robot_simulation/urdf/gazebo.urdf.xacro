<?xml version="1.0"?>
<robot name="robotops_base" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="description_dir" default="$(find robot_description)"/>
  <xacro:arg name="geometry_file" default="$(arg description_dir)/config/geometry.yaml"/>
  <xacro:arg name="sensors" default="true"/>
  <xacro:arg name="controllers_file" default=""/>
  <xacro:if value="${'$(arg controllers_file)' == ''}">
    ${xacro.fatal('controllers_file is required by the Gazebo adapter')}
  </xacro:if>
  <xacro:include filename="$(arg description_dir)/urdf/base.xacro"/>
  <xacro:include filename="$(arg description_dir)/urdf/control.xacro"/>
  <xacro:robot_base geometry_file="$(arg geometry_file)"/>
  <xacro:wheel_control hardware_plugin="gz_ros2_control/GazeboSimSystem">
    <hardware_parameters/>
  </xacro:wheel_control>
  <gazebo>
    <!-- Inventory is checked against Gazebo's fixed-joint-reduced model. -->
    <plugin filename="librobotops_contact_evidence.so" name="robot_simulation::ContactEvidence">
      <topic>validation/contacts</topic>
      <body>base_link::base_link_fixed_joint_lump__caster_link_collision</body>
      <body>base_link::base_link_fixed_joint_lump__chassis_link_collision_1</body>
      <body>base_link::base_link_fixed_joint_lump__imu_link_collision_2</body>
      <body>base_link::base_link_fixed_joint_lump__lidar_link_collision_3</body>
      <body>left_wheel_link::left_wheel_link_collision</body>
      <body>right_wheel_link::right_wheel_link_collision</body>
      <support_body>base_link::base_link_fixed_joint_lump__caster_link_collision</support_body>
      <support_body>left_wheel_link::left_wheel_link_collision</support_body>
      <support_body>right_wheel_link::right_wheel_link_collision</support_body>
      <floor>control_pad_floor::floor::floor_collision</floor>
    </plugin>
    <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controllers_file)</parameters>
    </plugin>
    <!-- Simulator truth is for adapter tests, never the live odometry/TF source. -->
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_link_pose>false</publish_link_pose>
      <publish_sensor_pose>false</publish_sensor_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose>
      <publish_model_pose>true</publish_model_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <update_frequency>30</update_frequency>
    </plugin>
  </gazebo>
  <gazebo reference="left_wheel_link"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="right_wheel_link"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <!-- A fixed ball caster uses low friction to permit yaw; not a powered wheel. -->
  <gazebo reference="caster_link"><mu1>0.001</mu1><mu2>0.001</mu2></gazebo>
  <xacro:if value="$(arg sensors)">
    <gazebo reference="lidar_link">
      <sensor name="lidar" type="gpu_lidar">
        <gz_frame_id>lidar_link</gz_frame_id>
        <topic>scan</topic>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <lidar>
          <scan><horizontal><samples>360</samples><resolution>1</resolution>
            <min_angle>${-pi}</min_angle><max_angle>${pi}</max_angle>
          </horizontal></scan>
          <range><min>0.12</min><max>12.0</max><resolution>0.01</resolution></range>
        </lidar>
      </sensor>
    </gazebo>
    <gazebo reference="imu_link">
      <sensor name="imu" type="imu">
        <gz_frame_id>imu_link</gz_frame_id>
        <topic>imu</topic>
        <update_rate>50</update_rate>
        <always_on>true</always_on>
      </sensor>
    </gazebo>
  </xacro:if>
</robot>
