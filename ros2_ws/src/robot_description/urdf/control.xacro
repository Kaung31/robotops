<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="wheel_control" params="hardware_plugin **hardware_parameters">
    <ros2_control name="RobotOpsBase" type="system">
      <hardware>
        <plugin>${hardware_plugin}</plugin>
        <xacro:insert_block name="hardware_parameters"/>
      </hardware>
      <xacro:macro name="controlled_wheel" params="side">
        <joint name="${side}_wheel_joint">
          <command_interface name="velocity"/>
          <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
          <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
        </joint>
      </xacro:macro>
      <xacro:controlled_wheel side="left"/>
      <xacro:controlled_wheel side="right"/>
    </ros2_control>
  </xacro:macro>
</robot>
