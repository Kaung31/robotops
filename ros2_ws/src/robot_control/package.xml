<?xml version="1.0"?>
<package format="3">
  <name>robot_control</name>
  <version>0.2.0</version>
  <description>Shared backend-independent control configuration and command arbitration.</description>
  <maintainer email="kai@example.com">Kai</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend version_gte="4.5.0">twist_mux</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>diff_drive_controller</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
