{
  "schema_version": 1,
  "schemas": {
    "manifest": {
      "$defs": {
        "Asset": {
          "additionalProperties": false,
          "properties": {
            "bytes": {
              "exclusiveMinimum": 0,
              "maximum": 1048576,
              "title": "Bytes",
              "type": "integer"
            },
            "end_ros_ns": {
              "anyOf": [
                {
                  "pattern": "^[0-9]+$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "End Ros Ns"
            },
            "kind": {
              "enum": [
                "poses",
                "scans",
                "map"
              ],
              "title": "Kind",
              "type": "string"
            },
            "path": {
              "pattern": "^(poses-[0-9]{3}\\.json\\.gz|scans-[0-9]{3}\\.json\\.gz|map\\.pgm\\.gz)$",
              "title": "Path",
              "type": "string"
            },
            "schema_version": {
              "const": 1,
              "default": 1,
              "title": "Schema Version",
              "type": "integer"
            },
            "sha256": {
              "pattern": "^[a-f0-9]{64}$",
              "title": "Sha256",
              "type": "string"
            },
            "start_ros_ns": {
              "anyOf": [
                {
                  "pattern": "^[0-9]+$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Start Ros Ns"
            }
          },
          "required": [
            "path",
            "kind",
            "bytes",
            "sha256",
            "start_ros_ns",
            "end_ros_ns"
          ],
          "title": "Asset",
          "type": "object"
        },
        "Config": {
          "additionalProperties": false,
          "properties": {
            "display_samples_are_authoritative_metrics": {
              "const": false,
              "default": false,
              "title": "Display Samples Are Authoritative Metrics",
              "type": "boolean"
            },
            "extrapolate": {
              "const": false,
              "default": false,
              "title": "Extrapolate",
              "type": "boolean"
            },
            "pose_gap_ns": {
              "const": 100000000,
              "default": 100000000,
              "title": "Pose Gap Ns",
              "type": "integer"
            },
            "pose_period_ns": {
              "const": 50000000,
              "default": 50000000,
              "title": "Pose Period Ns",
              "type": "integer"
            },
            "ray_stride": {
              "const": 4,
              "default": 4,
              "title": "Ray Stride",
              "type": "integer"
            },
            "scan_stride": {
              "const": 2,
              "default": 2,
              "title": "Scan Stride",
              "type": "integer"
            },
            "tf_bracket_gap_ns": {
              "const": 250000000,
              "default": 250000000,
              "title": "Tf Bracket Gap Ns",
              "type": "integer"
            }
          },
          "title": "Config",
          "type": "object"
        },
        "Coverage": {
          "additionalProperties": false,
          "properties": {
            "full_mission_replay": {
              "const": false,
              "default": false,
              "title": "Full Mission Replay",
              "type": "boolean"
            },
            "gaps": {
              "items": {
                "$ref": "#/$defs/Gap"
              },
              "title": "Gaps",
              "type": "array"
            },
            "missing_channels": {
              "items": {
                "enum": [
                  "AMCL_POSE",
                  "GAZEBO_POSE_TRUTH",
                  "NAV2_ACTION_EVENTS",
                  "PLANNED_PATH",
                  "FAULT_EVENTS"
                ],
                "type": "string"
              },
              "title": "Missing Channels",
              "type": "array"
            },
            "source_scans": {
              "minimum": 0,
              "title": "Source Scans",
              "type": "integer"
            },
            "source_scans_without_map_tf": {
              "minimum": 0,
              "title": "Source Scans Without Map Tf",
              "type": "integer"
            },
            "unavailable_scan_stamps_ns": {
              "items": {
                "pattern": "^[0-9]+$",
                "type": "string"
              },
              "title": "Unavailable Scan Stamps Ns",
              "type": "array"
            }
          },
          "required": [
            "gaps",
            "source_scans",
            "source_scans_without_map_tf",
            "unavailable_scan_stamps_ns",
            "missing_channels"
          ],
          "title": "Coverage",
          "type": "object"
        },
        "Exporter": {
          "additionalProperties": false,
          "properties": {
            "code_sha256": {
              "pattern": "^[a-f0-9]{64}$",
              "title": "Code Sha256",
              "type": "string"
            },
            "config": {
              "$ref": "#/$defs/Config"
            },
            "config_sha256": {
              "pattern": "^[a-f0-9]{64}$",
              "title": "Config Sha256",
              "type": "string"
            },
            "version": {
              "const": "p2.n0.v1",
              "default": "p2.n0.v1",
              "title": "Version",
              "type": "string"
            }
          },
          "required": [
            "code_sha256",
            "config_sha256",
            "config"
          ],
          "title": "Exporter",
          "type": "object"
        },
        "Gap": {
          "additionalProperties": false,
          "properties": {
            "end_ros_ns": {
              "pattern": "^[0-9]+$",
              "title": "End Ros Ns",
              "type": "string"
            },
            "reason": {
              "enum": [
                "UNRECORDED_HEAD",
                "UNRECORDED_TAIL",
                "TF_UNAVAILABLE",
                "POSE_GAP",
                "DISPLAY_POSE_HEAD",
                "DISPLAY_POSE_TAIL"
              ],
              "title": "Reason",
              "type": "string"
            },
            "start_ros_ns": {
              "pattern": "^[0-9]+$",
              "title": "Start Ros Ns",
              "type": "string"
            }
          },
          "required": [
            "start_ros_ns",
            "end_ros_ns",
            "reason"
          ],
          "title": "Gap",
          "type": "object"
        },
        "Identity": {
          "additionalProperties": false,
          "properties": {
            "campaign_id": {
              "pattern": "^[a-zA-Z0-9_-]{1,128}$",
              "title": "Campaign Id",
              "type": "string"
            },
            "environment": {
              "const": "mapping_lab",
              "title": "Environment",
              "type": "string"
            },
            "experiment_id": {
              "pattern": "^[a-zA-Z0-9_-]{1,128}$",
              "title": "Experiment Id",
              "type": "string"
            },
            "map_id": {
              "const": "control_pad_v1",
              "title": "Map Id",
              "type": "string"
            },
            "mode": {
              "const": "sim",
              "default": "sim",
              "title": "Mode",
              "type": "string"
            },
            "original_config_sha256": {
              "pattern": "^[a-f0-9]{64}$",
              "title": "Original Config Sha256",
              "type": "string"
            },
            "original_parameters_sha256": {
              "pattern": "^[a-f0-9]{64}$",
              "title": "Original Parameters Sha256",
              "type": "string"
            },
            "profile": {
              "const": "navfn_rpp",
              "title": "Profile",
              "type": "string"
            },
            "report_id": {
              "pattern": "^[a-f0-9]{64}$",
              "title": "Report Id",
              "type": "string"
            },
            "robot_model": {
              "const": "robotops_base",
              "title": "Robot Model",
              "type": "string"
            },
            "run_id": {
              "pattern": "^[a-zA-Z0-9_-]{1,128}$",
              "title": "Run Id",
              "type": "string"
            },
            "software_revision": {
              "default": null,
              "title": "Software Revision",
              "type": "null"
            },
            "software_revision_reason": {
              "const": "UNAVAILABLE_IN_ORIGINAL",
              "default": "UNAVAILABLE_IN_ORIGINAL",
              "title": "Software Revision Reason",
              "type": "string"
            },
            "trial_id": {
              "pattern": "^[a-zA-Z0-9_-]{1,128}$",
              "title": "Trial Id",
              "type": "string"
            }
          },
          "required": [
            "campaign_id",
            "experiment_id",
            "trial_id",
            "run_id",
            "report_id",
            "robot_model",
            "environment",
            "profile",
            "map_id",
            "original_config_sha256",
            "original_parameters_sha256"
          ],
          "title": "Identity",
          "type": "object"
        },
        "Metric": {
          "additionalProperties": false,
          "properties": {
            "name": {
              "enum": [
                "mission_ros_seconds",
                "odom_path_metres",
                "xy_error_m",
                "yaw_error_rad"
              ],
              "title": "Name",
              "type": "string"
            },
            "pointer": {
              "pattern": "^/campaign/trials/0/evidence/(metrics|validation)/[a-z_]+$",
              "title": "Pointer",
              "type": "string"
            },
            "quality": {
              "const": "ORIGINAL_VERIFIED",
              "default": "ORIGINAL_VERIFIED",
              "title": "Quality",
              "type": "string"
            },
            "source_ref": {
              "const": "report",
              "default": "report",
              "title": "Source Ref",
              "type": "string"
            },
            "unit": {
              "enum": [
                "s",
                "m",
                "rad"
              ],
              "title": "Unit",
              "type": "string"
            },
            "value": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Value"
            }
          },
          "required": [
            "name",
            "value",
            "unit",
            "pointer"
          ],
          "title": "Metric",
          "type": "object"
        },
        "Original": {
          "additionalProperties": false,
          "properties": {
            "action_status": {
              "default": null,
              "title": "Action Status",
              "type": "null"
            },
            "action_status_reason": {
              "const": "NOT_RECORDED_IN_SOURCE_REPORT",
              "default": "NOT_RECORDED_IN_SOURCE_REPORT",
              "title": "Action Status Reason",
              "type": "string"
            },
            "commanded_final_goal": {
              "$ref": "#/$defs/XYTheta"
            },
            "contact_count": {
              "minimum": 0,
              "title": "Contact Count",
              "type": "integer"
            },
            "contact_end_ros_ns": {
              "pattern": "^[0-9]+$",
              "title": "Contact End Ros Ns",
              "type": "string"
            },
            "contact_frame_count": {
              "exclusiveMinimum": 0,
              "title": "Contact Frame Count",
              "type": "integer"
            },
            "contact_scope": {
              "const": "ADAPTER_MONITORED_GEOMETRY_ONLY",
              "default": "ADAPTER_MONITORED_GEOMETRY_ONLY",
              "title": "Contact Scope",
              "type": "string"
            },
            "contact_start_ros_ns": {
              "pattern": "^[0-9]+$",
              "title": "Contact Start Ros Ns",
              "type": "string"
            },
            "contact_verdict": {
              "const": "NO_CONTACT_OBSERVED",
              "title": "Contact Verdict",
              "type": "string"
            },
            "final_localized_pose": {
              "$ref": "#/$defs/XYTheta"
            },
            "final_observed_ros_ns": {
              "pattern": "^[0-9]+$",
              "title": "Final Observed Ros Ns",
              "type": "string"
            },
            "final_pose_is_playback_sample": {
              "const": false,
              "default": false,
              "title": "Final Pose Is Playback Sample",
              "type": "boolean"
            },
            "final_pose_ros_ns": {
              "pattern": "^[0-9]+$",
              "title": "Final Pose Ros Ns",
              "type": "string"
            },
            "pose_policy": {
              "$ref": "#/$defs/Policy"
            },
            "pose_verdict": {
              "const": "POSE_VERIFIED",
              "title": "Pose Verdict",
              "type": "string"
            },
            "ros_outcome": {
              "const": "succeeded",
              "title": "Ros Outcome",
              "type": "string"
            },
            "sanitized_derivative_not_original_report": {
              "const": true,
              "default": true,
              "title": "Sanitized Derivative Not Original Report",
              "type": "boolean"
            },
            "source_ref": {
              "const": "report",
              "default": "report",
              "title": "Source Ref",
              "type": "string"
            },
            "universal_collision_freedom_assessable": {
              "const": false,
              "default": false,
              "title": "Universal Collision Freedom Assessable",
              "type": "boolean"
            }
          },
          "required": [
            "ros_outcome",
            "pose_verdict",
            "pose_policy",
            "commanded_final_goal",
            "final_localized_pose",
            "final_pose_ros_ns",
            "final_observed_ros_ns",
            "contact_verdict",
            "contact_start_ros_ns",
            "contact_end_ros_ns",
            "contact_frame_count",
            "contact_count"
          ],
          "title": "Original",
          "type": "object"
        },
        "Policy": {
          "additionalProperties": false,
          "properties": {
            "localization_max_age_s": {
              "title": "Localization Max Age S",
              "type": "number"
            },
            "max_xy_variance_m2": {
              "title": "Max Xy Variance M2",
              "type": "number"
            },
            "max_yaw_variance_rad2": {
              "title": "Max Yaw Variance Rad2",
              "type": "number"
            },
            "tf_max_age_s": {
              "title": "Tf Max Age S",
              "type": "number"
            },
            "xy_tolerance_m": {
              "title": "Xy Tolerance M",
              "type": "number"
            },
            "yaw_tolerance_rad": {
              "title": "Yaw Tolerance Rad",
              "type": "number"
            }
          },
          "required": [
            "xy_tolerance_m",
            "yaw_tolerance_rad",
            "tf_max_age_s",
            "localization_max_age_s",
            "max_xy_variance_m2",
            "max_yaw_variance_rad2"
          ],
          "title": "Policy",
          "type": "object"
        },
        "Scene": {
          "additionalProperties": false,
          "properties": {
            "coordinates": {
              "const": "ROS_RIGHT_HANDED_METRES_Z_UP",
              "default": "ROS_RIGHT_HANDED_METRES_Z_UP",
              "title": "Coordinates",
              "type": "string"
            },
            "encoding": {
              "const": "P5_GRAY8_TOP_DOWN",
              "default": "P5_GRAY8_TOP_DOWN",
              "title": "Encoding",
              "type": "string"
            },
            "frame_chain": {
              "const": "map->odom->base_link->lidar_link",
              "default": "map->odom->base_link->lidar_link",
              "title": "Frame Chain",
              "type": "string"
            },
            "free_threshold": {
              "title": "Free Threshold",
              "type": "number"
            },
            "height": {
              "exclusiveMinimum": 0,
              "title": "Height",
              "type": "integer"
            },
            "map_asset": {
              "const": "map.pgm.gz",
              "default": "map.pgm.gz",
              "title": "Map Asset",
              "type": "string"
            },
            "negate": {
              "const": 0,
              "default": 0,
              "title": "Negate",
              "type": "integer"
            },
            "occupied_threshold": {
              "title": "Occupied Threshold",
              "type": "number"
            },
            "origin": {
              "items": {
                "type": "number"
              },
              "maxItems": 3,
              "minItems": 3,
              "title": "Origin",
              "type": "array"
            },
            "resolution_m": {
              "title": "Resolution M",
              "type": "number"
            },
            "visual_model": {
              "default": null,
              "title": "Visual Model",
              "type": "null"
            },
            "visual_model_reason": {
              "const": "NO_CURATED_VISUAL_ASSET",
              "default": "NO_CURATED_VISUAL_ASSET",
              "title": "Visual Model Reason",
              "type": "string"
            },
            "width": {
              "exclusiveMinimum": 0,
              "title": "Width",
              "type": "integer"
            }
          },
          "required": [
            "width",
            "height",
            "resolution_m",
            "origin",
            "occupied_threshold",
            "free_threshold"
          ],
          "title": "Scene",
          "type": "object"
        },
        "Segment": {
          "additionalProperties": false,
          "properties": {
            "end_ros_ns": {
              "pattern": "^[0-9]+$",
              "title": "End Ros Ns",
              "type": "string"
            },
            "end_us": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "title": "End Us",
              "type": "integer"
            },
            "epoch": {
              "const": 0,
              "default": 0,
              "title": "Epoch",
              "type": "integer"
            },
            "frame": {
              "const": "map",
              "default": "map",
              "title": "Frame",
              "type": "string"
            },
            "id": {
              "pattern": "^[a-zA-Z0-9_-]{1,128}$",
              "title": "Id",
              "type": "string"
            },
            "interpolate_across_segments": {
              "const": false,
              "default": false,
              "title": "Interpolate Across Segments",
              "type": "boolean"
            },
            "interpolate_within_max_gap_ns": {
              "const": 100000000,
              "default": 100000000,
              "title": "Interpolate Within Max Gap Ns",
              "type": "integer"
            },
            "start_ros_ns": {
              "pattern": "^[0-9]+$",
              "title": "Start Ros Ns",
              "type": "string"
            },
            "start_us": {
              "maximum": 9007199254740991,
              "minimum": 0,
              "title": "Start Us",
              "type": "integer"
            }
          },
          "required": [
            "id",
            "start_ros_ns",
            "end_ros_ns",
            "start_us",
            "end_us"
          ],
          "title": "Segment",
          "type": "object"
        },
        "Source": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "pattern": "^[a-zA-Z0-9_-]{1,128}$",
              "title": "Id",
              "type": "string"
            },
            "integrity": {
              "const": "VERIFIED",
              "default": "VERIFIED",
              "title": "Integrity",
              "type": "string"
            },
            "kind": {
              "enum": [
                "report",
                "mcap",
                "run_metadata",
                "run_result",
                "bag_metadata",
                "runner_manifest",
                "contacts",
                "map_yaml",
                "map_image"
              ],
              "title": "Kind",
              "type": "string"
            },
            "scope": {
              "enum": [
                "original_bound",
                "audit_snapshot_only"
              ],
              "title": "Scope",
              "type": "string"
            },
            "sha256": {
              "pattern": "^[a-f0-9]{64}$",
              "title": "Sha256",
              "type": "string"
            }
          },
          "required": [
            "id",
            "kind",
            "sha256",
            "scope"
          ],
          "title": "Source",
          "type": "object"
        },
        "Time": {
          "additionalProperties": false,
          "properties": {
            "dispatch_ns": {
              "pattern": "^[0-9]+$",
              "title": "Dispatch Ns",
              "type": "string"
            },
            "domain": {
              "const": "recorded_ros_simulation",
              "default": "recorded_ros_simulation",
              "title": "Domain",
              "type": "string"
            },
            "epoch": {
              "const": 0,
              "default": 0,
              "title": "Epoch",
              "type": "integer"
            },
            "final_observation_ns": {
              "pattern": "^[0-9]+$",
              "title": "Final Observation Ns",
              "type": "string"
            },
            "mission_end_ns": {
              "pattern": "^[0-9]+$",
              "title": "Mission End Ns",
              "type": "string"
            },
            "mission_start_ns": {
              "pattern": "^[0-9]+$",
              "title": "Mission Start Ns",
              "type": "string"
            },
            "offset_origin_ns": {
              "pattern": "^[0-9]+$",
              "title": "Offset Origin Ns",
              "type": "string"
            },
            "recorded_end_ns": {
              "pattern": "^[0-9]+$",
              "title": "Recorded End Ns",
              "type": "string"
            },
            "recorded_start_ns": {
              "pattern": "^[0-9]+$",
              "title": "Recorded Start Ns",
              "type": "string"
            },
            "wall_mapping": {
              "default": null,
              "title": "Wall Mapping",
              "type": "null"
            }
          },
          "required": [
            "mission_start_ns",
            "mission_end_ns",
            "dispatch_ns",
            "final_observation_ns",
            "recorded_start_ns",
            "recorded_end_ns",
            "offset_origin_ns"
          ],
          "title": "Time",
          "type": "object"
        },
        "XYTheta": {
          "additionalProperties": false,
          "properties": {
            "x": {
              "title": "X",
              "type": "number"
            },
            "y": {
              "title": "Y",
              "type": "number"
            },
            "yaw": {
              "title": "Yaw",
              "type": "number"
            }
          },
          "required": [
            "x",
            "y",
            "yaw"
          ],
          "title": "XYTheta",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "assets": {
          "items": {
            "$ref": "#/$defs/Asset"
          },
          "title": "Assets",
          "type": "array"
        },
        "coverage": {
          "$ref": "#/$defs/Coverage"
        },
        "dataset_id": {
          "const": "N0",
          "default": "N0",
          "title": "Dataset Id",
          "type": "string"
        },
        "exporter": {
          "$ref": "#/$defs/Exporter"
        },
        "kind": {
          "const": "robotops.recorded_playback",
          "default": "robotops.recorded_playback",
          "title": "Kind",
          "type": "string"
        },
        "limitations": {
          "items": {
            "enum": [
              "PARTIAL_MISSION_RECORDING",
              "INITIAL_TF_GAP",
              "LOCALIZED_TF_NOT_PHYSICAL_TRUTH",
              "NO_NAV2_EVENT_RECONSTRUCTION",
              "DISPLAY_DOWNSAMPLED",
              "NO_ORIGINAL_GIT_REVISION",
              "HASHES_NOT_SIGNATURES",
              "SCOPED_CONTACT_OBSERVATION_ONLY"
            ],
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/Metric"
          },
          "title": "Metrics",
          "type": "array"
        },
        "navigation_events": {
          "items": {
            "type": "null"
          },
          "maxItems": 0,
          "title": "Navigation Events",
          "type": "array"
        },
        "original_validation": {
          "$ref": "#/$defs/Original"
        },
        "publication_review": {
          "const": "PRIVATE_NOT_APPROVED_FOR_UPLOAD",
          "default": "PRIVATE_NOT_APPROVED_FOR_UPLOAD",
          "title": "Publication Review",
          "type": "string"
        },
        "scene": {
