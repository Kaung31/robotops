{
  "name": "robotops-web",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "node --test tests/*.test.mjs",
    "replay": "npm run build:replay && node scripts/serve-replay.mjs",
    "build:replay": "tsc -b && vite build --config vite.replay.config.ts",
    "build:site": "tsc -b && vite build --config vite.site.config.ts && node scripts/finalize-site.mjs",
    "build:candidate": "npm run build:site && node scripts/include-candidate-data.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.0.0",
    "typescript": "^5.9.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0"
  }
}
