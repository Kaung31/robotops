# Optional campaign metadata override; default is <repo>/artifacts/campaigns.sqlite3.
# Export variables through your launcher; FastAPI does not load this file itself.
# Prefer an absolute path outside source control if overriding the default.
# ROBOTOPS_CAMPAIGN_DB=/absolute/path/to/robotops/campaigns.sqlite3

# Opt-in backend worker; requires a sourced Jazzy workspace and sim ROS gateway.
# The React campaign panel requires this opt-in and observes backend execution.
# ROBOTOPS_CAMPAIGN_EXECUTION=1

# Optional read-only ROS freshness monitor in robot bringup (off by default).
# Export before starting the backend so its child launches inherit this setting.
# Only literal true/false are accepted; an explicit diagnostics:=false overrides it.
# ROBOTOPS_DIAGNOSTICS=true
